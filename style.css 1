body {
  font-family: 'Segoe UI', sans-serif;
  margin: 0;
  background-color: #f9f9f9;
  color: #333;
}
header, footer {
  text-align: center;
  background-color: #222;
  color: white;
  padding: 20px;
}
section {
  padding: 40px;
  max-width: 800px;
  margin: auto;
}
.gallery img {
  width: 250px;
  margin: 10px;
  border-radius: 8px;
  transition: transform 0.3s;
}
.gallery img:hover {
  transform: scale(1.05);
}
